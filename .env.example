# Optional. The Budget API host the portal reads from. Leave unset to use the
# value in portal.config.ts (https://budget.bettergov.ph by default).
# VITE_API_BASE=https://budget.bettergov.ph

# The AI Search instance the chat assistant searches (npm run kb:sync, kb:update). The token needs only
# AI Search Edit and AI Search Run on the account. Not named CLOUDFLARE_*, which Wrangler would read as
# its own login. .env is never committed.
KB_ACCOUNT_ID=
KB_API_TOKEN=
KB_NAMESPACE=bettercarmona-kb
KB_INSTANCE=bettercarmona-kb
